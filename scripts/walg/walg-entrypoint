#!/bin/bash
# walg-entrypoint [ARGS...]: a managed database's entrypoint. It hands over to
# the image's own, unless the database is a restore whose data is not there yet
# (HivePaaS's managed templates design, §4). Then it fetches the base backup from
# the source's archive, writes the recovery settings, and runs the server through
# the recovery, its log kept, to tell a recovery that failed from a restart.
# After one that failed, it idles, so that status can say why.
#   A replica (§9) is a standby of the primary HIVEPAAS_STANDBY_HOST names: seeded
# from the archive's latest base backup, never from an empty directory, then
# streaming as $replication_user, the archive its fallback. Its password is the
# file HIVEPAAS_STANDBY_PASSWORD_FILE names, written for libpq to a passfile in
# memory at each start; HIVEPAAS_STANDBY_NAME is what the primary knows it by. A
# replica walg-promote promoted starts as the primary, whatever these say.
#   A database HIVEPAAS_FENCED is set on is a primary another was promoted over:
# it idles and never starts its server, whoever starts its service, so that no
# two primaries write to the cluster's archive.
#   A primary initializes an empty data directory only over an archive that holds
# nothing. One that holds base backups or WAL was written by this database: its
# data is lost, or on another volume than this one - a "shared" one that is not.
# Initialized here, it would archive into that history: it idles instead, saying
# why. An archive it cannot read within HIVEPAAS_ARCHIVE_CHECK_TIMEOUT seconds
# (60) fails the start, for Swarm to start it again.
#   walg-entrypoint status: 0 once the server is up and promoted, 75 while it
#     starts or recovers, 1 when the recovery failed, having printed why.
#   walg-entrypoint health: the container's health check, healthy while it
#     restores.
set -uo pipefail
# shellcheck source=walg-lib
. /opt/hivepaas/bin/walg-lib

state_dir=$(data_root)/hivepaas-restore
log=$state_dir/recovery.log
state() { cat "$state_dir/state" 2>/dev/null || true; }
set_state() {
  mkdir -p "$state_dir"
  echo "$1" > "$state_dir/state.new" && mv "$state_dir/state.new" "$state_dir/state"
}
restoring() { [ -n "${HIVEPAAS_RESTORE_SECRETS_DIR:-}" ]; }
standby() { [ -n "${HIVEPAAS_STANDBY_HOST:-}" ]; }
fenced() { [ -n "${HIVEPAAS_FENCED:-}" ]; }
# A passfile in memory: the password is never on the data volume.
passfile=/dev/shm/hivepaas-standby.pgpass

status() {
  case $(state) in
    failed)
      echo "The recovery failed:"
      grep -E 'FATAL|PANIC' "$log" | tail -n 5 || tail -n 20 "$log"
      exit 1
      ;;
    fetching) exit 75 ;;
  esac
  case $(sql "select pg_is_in_recovery()" 2>/dev/null) in
    f)
      if [ "$(state)" = recovering ]; then set_state "done"; fi
      exit 0
      ;;
    *) exit 75 ;;
  esac
}

health() {
  if fenced || [ -s "$(refusal_file)" ]; then exit 0; fi
  if restoring; then
    case $(state) in fetching | recovering | failed) exit 0 ;; esac
  fi
  if standby; then
    case $(state) in standby-fetching | standby-failed) exit 0 ;; esac
  fi
  exec pg_isready -h "$pg_host" -U "$pg_user" -d "${POSTGRES_DB:-postgres}"
}

idle() {
  trap 'exit 0' TERM INT
  while :; do sleep 3600 & wait $!; done
}

fetch() {
  local backup=${HIVEPAAS_RESTORE_TARGET_BACKUP:-}
  set_state fetching
  mkdir -p "$PGDATA"
  find "$PGDATA" -mindepth 1 -delete
  chown postgres:postgres "$PGDATA"
  chmod 700 "$PGDATA"
  if [ -z "$backup" ]; then
    backup=$(backup_before "$(date -u -d "${HIVEPAAS_RESTORE_TARGET_BEFORE:?a restore needs its target}" +%s)" \
      --source) || return 1
  fi
  echo "Fetching $backup from the source's archive..."
  gosu postgres "$bin/walg-run" --source backup-fetch "$PGDATA" "$backup" || return 1
  clear_recovery "$PGDATA"
  {
    echo "restore_command = '$bin/walg-fetch %f %p'"
    for setting in ${HIVEPAAS_RESTORE_RECOVERY:-}; do echo "${setting%%=*} = '${setting#*=}'"; done
    echo "recovery_target_action = 'promote'"
  } >> "$PGDATA/postgresql.auto.conf"
  touch "$PGDATA/recovery.signal"
  chown postgres:postgres "$PGDATA/postgresql.auto.conf" "$PGDATA/recovery.signal"
  set_state recovering
}

recover() {
  local pid code stopping="" from
  mkdir -p "$state_dir"
  touch "$log"
  from=$(($(wc -l < "$log") + 1))
  docker-entrypoint.sh "$@" > >(tee -a "$log") 2>&1 &
  pid=$!
  trap 'stopping=1; kill -TERM "$pid" 2>/dev/null' TERM
  trap 'stopping=1; kill -INT "$pid" 2>/dev/null' INT
  while kill -0 "$pid" 2>/dev/null; do wait "$pid"; done
  wait "$pid"
  code=$?
  # Promoted - in this run's log, or seen by status - the server stopped as any
  # does, and the next start is an ordinary one. Stopped while it recovered, the
  # next start goes on recovering.
  if [ "$(state)" = "done" ] || tail -n +"$from" "$log" | grep -q 'database system is ready to accept connections'
  then
    set_state "done"
    exit "$code"
  fi
  if [ -n "$stopping" ]; then exit "$code"; fi
  set_state failed
  echo "The recovery failed; the database idles so that its restore can say why." >&2
  idle
}

# standby_setup: the passfile, the data seeded from the archive when there is
# none, and the standby's settings, written again at each start: the primary
# named may have moved.
standby_setup() {
  local password
  password=$(cat "${HIVEPAAS_STANDBY_PASSWORD_FILE:?a replica needs the replication password}") || return 1
  (umask 077 && printf '%s:5432:*:%s:%s\n' "$HIVEPAAS_STANDBY_HOST" "$replication_user" "$password" > "$passfile")
  chown postgres:postgres "$passfile"
  if [ "$(state)" = standby-fetching ] || [ ! -s "$PGDATA/PG_VERSION" ]; then
    set_state standby-fetching
    mkdir -p "$PGDATA"
    find "$PGDATA" -mindepth 1 -delete
    chown postgres:postgres "$PGDATA"
    chmod 700 "$PGDATA"
    echo "Seeding the replica from the archive's latest base backup..."
    gosu postgres "$bin/walg-run" backup-fetch "$PGDATA" LATEST || return 1
  fi
  clear_recovery "$PGDATA"
  {
    echo "primary_conninfo = 'host=$HIVEPAAS_STANDBY_HOST port=5432 user=$replication_user passfile=$passfile \
application_name=${HIVEPAAS_STANDBY_NAME:-replica}'"
    echo "restore_command = '$bin/walg-fetch %f %p'"
    echo "recovery_target_timeline = 'latest'"
  } >> "$PGDATA/postgresql.auto.conf"
  touch "$PGDATA/standby.signal"
  chown postgres:postgres "$PGDATA/postgresql.auto.conf" "$PGDATA/standby.signal"
  set_state standby
}

# checkpoint_once: one CHECKPOINT, once the server is up. After a start PostgreSQL
# forces no segment switch until its first checkpoint, checkpoint_timeout later, so
# archive_timeout would only hold from then. It waits for the server itself, not
# the one docker-entrypoint.sh runs on the socket alone while it initializes a new
# data directory. It always exits 0: in a container without an init, the server
# reaps it, and takes any other exit for a backend's crash.
checkpoint_once() {
  for _ in $(seq 600); do
    if [ "$(sql "select current_setting('listen_addresses') <> ''" 2>/dev/null)" = t ]; then
      if sql checkpoint >/dev/null 2>&1; then
        echo "walg-entrypoint: checkpointed once the server was up, so archive_timeout holds from now"
      else
        echo "walg-entrypoint: the checkpoint after the start failed; archive_timeout holds from the first one" >&2
      fi
      exit 0
    fi
    sleep 1
  done
  exit 0
}

# guard_fresh_start: what an empty data directory is initialized over. An
# archive that holds anything refuses it, which the refusal file keeps for health
# and walg-health; one that cannot be read fails the start.
guard_fresh_start() {
  local listed reason
  if ! listed=$(timeout "${HIVEPAAS_ARCHIVE_CHECK_TIMEOUT:-60}" "$bin/walg-run" st ls 2>/dev/null); then
    echo "walg-entrypoint: the archive could not be read, so whether it holds this database's history is" \
      "not known: the start fails, to be tried again, rather than initialize the data directory" >&2
    exit 1
  fi
  if grep -qE '(basebackups_005|wal_005)/' <<<"$listed"; then
    reason="The data directory is empty, and the archive at ${WALG_S3_PREFIX:-${WALG_FILE_PREFIX:-}} holds this"
    reason+=" database's history: its data is lost, or on another volume than this one. The database is not"
    reason+=" initialized afresh, which would archive into that history: restore it into a new app, or give it"
    reason+=" its volume back."
    echo "$reason" > "$(refusal_file)"
    echo "walg-entrypoint: $reason" >&2
    idle
  fi
}

# serve ARGS...: the image's entrypoint, with one checkpoint once a server it
# starts is up. The checkpoint runs detached twice, so that it is not the server's
# child once this script has become the server.
serve() {
  if [ "${1:-}" = postgres ]; then ( checkpoint_once & ); fi
  exec docker-entrypoint.sh "$@"
}

case ${1:-} in
  status) status ;;
  health) health ;;
esac

if fenced; then
  echo "walg-entrypoint: fenced ($HIVEPAAS_FENCED): another member is the primary; this one idles and never" \
    "starts its server" >&2
  idle
fi
# A replica never starts from an empty directory: one it cannot seed idles.
if standby && [ -e "$(promoted_marker)" ]; then
  echo "walg-entrypoint: promoted before; starts as the primary"
  serve "$@"
fi
if standby; then
  if ! standby_setup; then
    set_state standby-failed
    echo "The replica could not be seeded from the archive; it idles rather than start empty." >&2
    idle
  fi
  serve "$@"
fi
if ! restoring; then
  rm -f "$(refusal_file)"
  if [ "${1:-}" = postgres ] && [ ! -s "$PGDATA/PG_VERSION" ]; then guard_fresh_start; fi
  serve "$@"
fi
case $(state) in
  failed)
    echo "The recovery failed before: see $log." >&2
    idle
    ;;
  "done") serve "$@" ;;
esac
if [ "$(state)" = fetching ] || [ ! -s "$PGDATA/PG_VERSION" ]; then
  if ! fetch; then
    set_state failed
    echo "The base backup could not be fetched; the database idles so that its restore can say why." | tee -a "$log" >&2
    idle
  fi
fi
recover "$@"
